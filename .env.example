APP_NAME=Lead Finder API
APP_ENV=dev
DEMO_MODE=false
DATABASE_URL=sqlite:///./leadfinder.db

GOOGLE_PLACES_API_KEY=
OPENCORPORATES_API_TOKEN=
HUNTER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

MAX_BUSINESSES_PER_REQUEST=25
HUNTER_DOMAIN_SEARCH_LIMIT=15
WEBSITE_CRAWL_MAX_PAGES=3
EMAIL_MIN_CONFIDENCE=0.8
EMAIL_REQUIRE_SAME_DOMAIN=true
EMAIL_REQUIRE_MX=true
EMAIL_REJECT_GENERIC_LOCALS=true
PHONE_DEFAULT_REGION=US
OUTBOUND_USER_AGENT=LeadFinderBot/0.2 (+https://localhost; contact=operator@local)
REQUEST_TIMEOUT_SECONDS=20
